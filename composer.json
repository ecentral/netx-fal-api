{
	"name": "fairway/netx-fal-api",
	"version": "1.0.0",
	"authors": [
		{
			"name": "eCentral GmbH",
			"role": "Project Owner",
			"email": "support@ecentral.de",
			"homepage": "https://www.ecentral.de"
		}
	],
	"type": "typo3-cms-extension",
	"description": "",
	"homepage": "https://www.brix.ch",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"typo3",
		"typo3 backend",
		"celum"
	],
	"autoload": {
		"psr-4": {
			"Fairway\\NetXFalApi\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"preferred-install": {
			"typo3/cms-core": "source"
		},
		"sort-packages": true
	},
	"require": {
		"php": "^8.2",
		"ext-curl": "*",
		"ext-json": "*",
		"ext-mbstring": "*",
		"guzzlehttp/guzzle": "^7.3",
		"guzzlehttp/psr7": "^1.7 || ^2.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^8.0 || ^9.0",
		"friendsofphp/php-cs-fixer": "^3.5"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload-dev": {
		"psr-4": {
			"Fairway\\NetXFalApi\\Tests\\": "Tests"
		}
	},
	"extra": {
		"typo3/cms": {
			"app-dir": ".Build",
			"web-dir": ".Build/Web",
			"extension-key": "netx_fal_api"
		}
	}
}
